{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreativeBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "core_emotion",
    "visual_metaphor",
    "camera_language",
    "color_arc",
    "editing_rhythm",
    "motifs",
    "do_not",
    "hero_moments"
  ],
  "properties": {
    "core_emotion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "visual_metaphor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "camera_language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "color_arc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "editing_rhythm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "motifs": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "do_not": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "hero_moments": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    }
  }
}
